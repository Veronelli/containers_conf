MAIL_STORAGE_IMAGE_NAME=mail-storage
MAIL_STORAGE_IMAGE_TAG=latest
MAIL_STORAGE_CONTAINER_NAME=mail-storage
MAIL_STORAGE_HOSTNAME=mail-storage
MAIL_STORAGE_RESTART_POLICY=unless-stopped
MAIL_STORAGE_PORT=143
MAIL_STORAGE_BIND_HOST=0.0.0.0
MAIL_STORAGE_BIND_PORT=143
MAIL_STORAGE_CPU_LIMIT=0.5
MAIL_STORAGE_MEMORY_LIMIT=512m
MAIL_STORAGE_HEALTHCHECK_INTERVAL=10s
MAIL_STORAGE_HEALTHCHECK_TIMEOUT=5s
MAIL_STORAGE_HEALTHCHECK_RETRIES=3
MAIL_STORAGE_HEALTHCHECK_START_PERIOD=10s
MAIL_STORAGE_MAIL_LOCATION=/var/mail/%{user}
MAIL_STORAGE_PAM_SERVICE=dovecot
MAIL_STORAGE_IMAP_TLS=no

SMTP_BIND_HOST=0.0.0.0
SMTP_BIND_PORT=25
SMTP_MYHOSTNAME=mail.example.com
SMTP_MYDOMAIN=example.com
SMTP_MYDESTINATION="$SMTP_MYHOSTNAME, localhost.$SMTP_MYDOMAIN, localhost"
SMTP_MYNETWORKS=127.0.0.0/8

# No-IP credentials and hostname; replace all values before starting the service.
NOIP_USERNAME=
NOIP_PASSWORD=
NOIP_HOSTNAME=
NOIP_UPDATE_INTERVAL=5m

# Temporary credentials used only by healthcheck-imap.sh; never commit real values.
IMAP_HEALTHCHECK_SENDER_PASSWORD=change-me-sender
IMAP_HEALTHCHECK_READER_PASSWORD=change-me-reader
