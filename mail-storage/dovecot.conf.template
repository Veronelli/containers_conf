dovecot_config_version = 2.4.0
dovecot_storage_version = 2.4.0

protocols = imap
listen = *
ssl = ${MAIL_STORAGE_IMAP_TLS}
auth_allow_cleartext = yes
auth_mechanisms = plain login

mail_driver = mbox
mail_path = ~/mail
mail_inbox_path = ${MAIL_STORAGE_MAIL_LOCATION}
mail_privileged_group = mail

log_path = /dev/stderr
info_log_path = /dev/stdout

passdb pam {
  service_name = ${MAIL_STORAGE_PAM_SERVICE}
}

userdb passwd {
}

service imap-login {
  inet_listener imap {
    port = ${MAIL_STORAGE_PORT}
  }
}
